{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.mjs"
            ],
            "statusMessage": "Loading project context..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-on-save.mjs",
            "statusMessage": "Formatting..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/audit-log.mjs",
            "async": true
          }
        ]
      }
    ]
  }
}
